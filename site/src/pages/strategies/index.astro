---
import Layout from '../../layouts/Layout.astro';
import MethodCard from '../../components/MethodCard.astro';
import {data,url} from '../../lib/content';
const full=data.comparison.periods.find((p:any)=>p.id==='full');
const recent=data.comparison.periods.find((p:any)=>p.id==='recent-10y');
const methods=data.methods.map((method:any)=>method.id==='volatility-allocation'?{
  ...method,
  summary:'현재 운용 프로필은 기본 VO에 5/20 상향돌파·구간당 1회 addon을 활성화합니다.',
  metrics:full.metrics.find((m:any)=>m.model==='vo_addon_5_20'),
  recent_metrics:recent.metrics.find((m:any)=>m.model==='vo_addon_5_20'),
}:method);
---
<Layout title="투자 방법" section="strategies" wide>
  <div class="page-heading"><span class="status-pill">{methods.length}개 방법</span><h1>투자 방법</h1><p>현재 운용 방법과 독립 실행 전략, 비교에 계속 사용할 기준만 남겼습니다. 채택하지 않은 후보와 실험군은 분석 기록에서 확인할 수 있습니다.</p></div>
  <div class="note"><strong>VO 카드는 5/20 addon을 켠 현재 운용 프로필입니다.</strong><p>VO 파생 규칙은 별도 투자 방법으로 중복 표시하지 않습니다. 채택된 규칙은 VO의 addon으로 통합하고, 미채택 결과는 분석 기록에 보존합니다.</p></div>
  <section class="method-list-conditions" aria-label="투자 방법 카드 공통 조건">
    <div><span>숫자 표기</span><strong>전체 평가 기간 <b>(최근 10년 이내)</b></strong></div>
    <div><span>기본 계산 조건</span><strong>초기 $100,000 · 매수·매도 각각 0.1% · 세금·슬리피지 0 · 달러 기준</strong></div>
    <p>전략별 실제 평가 기간과 예외 비용 조건은 상세 페이지에서 확인할 수 있습니다.</p>
  </section>
  <div class="methods-list">{methods.map((s:any)=><section id={s.id} data-method-entry data-no-toc><MethodCard method={s} featured={s.id==='volatility-allocation'}/></section>)}</div>
  <p class="caption method-footnote">이 목록에서 제외된 실험도 삭제된 것은 아닙니다. 규칙·성과·미채택 사유는 <a href={url('research/')}>분석 기록</a>에 그대로 보존합니다. <a href={url('strategies/volatility-allocation/#performance')}>최신 VO 비교 ({data.comparison.market_date}) →</a></p>
</Layout>
