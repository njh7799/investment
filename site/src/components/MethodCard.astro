---
import RuleExample from './RuleExample.astro';
import MethodConditions from './MethodConditions.astro';
import {methodInfo,resultLink,compareLink} from '../lib/methods';
import MethodMetrics from './MethodMetrics.astro';
import {url,pct,label} from '../lib/content';
const {method:s,featured=false}=Astro.props;
const href=s.href||`strategies/${s.id}/`;
const rows=s.result_rows||[];
const m=s.metrics;
const info=methodInfo(s);
---
<article data-method={s.id}>
  <details class:list={['method-card','method-details',{'featured-method':featured}]} open={featured}>
    <summary class="method-toggle">
      <div class="method-card-heading"><span class="status-pill">역할 · {info.role}</span><span class="status-pill">검증 · {info.status}</span><span class="method-category">{s.category}</span></div>
      <h2>{s.title}</h2>
      <p class="method-summary">{s.summary}</p>
      <MethodConditions method={s}/>{m&&<MethodMetrics metrics={m}/>}<p class="method-verdict">판단 · {info.verdict}</p>
      {!m&&s.is_family&&<p class="family-metric-note">CAGR·MDD는 {rows.length}개 설정별로 비교합니다.</p>}
      <span class="method-toggle-label"><span class="when-closed">펼치기 ＋</span><span class="when-open">접기 −</span></span>
    </summary>
    <div class="method-expanded">
      {!m&&(s.is_family?<div class="method-evaluation"><p>{rows.length}개 설정을 비교한 방법군입니다. 설정마다 성과가 달라 하나의 수익률로 표시하지 않습니다.</p>{rows.length<=13&&<div class="table-scroll"><table><thead><tr><th>설정</th><th>평가 기간</th><th>연평균 복리수익률</th><th>최대 낙폭</th></tr></thead><tbody>{rows.map((r:any)=><tr><th>{label(r.model)}</th><td>{r.start} — {r.end}</td><td>{pct(r.cagr)}</td><td>{pct(r.mdd)}</td></tr>)}</tbody></table></div>}<a href={url(`research/${s.batch}/#results`)}>모든 설정의 성과·낙폭·회복 비교 →</a></div>:<div class="method-evaluation"><p>실행 실패 · 백테스트 성과를 생성하지 않았습니다.</p></div>)}
      {s.preview&&<><p class="caption preview-context">아래 차트: {s.preview.caption}. 카드의 연구 당시 지표와 평가 기간이 다를 수 있습니다. {info.usesTqqq&&"2010-02-11 이전 TQQQ는 QQQ 기반 합성입니다."}</p><figure class:list={['method-preview',{'period-strip-preview':s.preview.strip}]}>{s.preview.strip?<a class="method-preview-strip" href={url(s.preview.href)} aria-label={`${s.title} 세 평가 구간 대화형 차트 열기`}><img src={url(s.preview.images[0].src)} alt={`${s.title}, ${s.preview.images[0].label} 자산 성장 비교`} width="2880" height="1440" loading="lazy" decoding="async"/></a>:<div class="method-preview-plots">{s.preview.images.map((image:any)=><section><h3>{image.label}</h3><a href={url(s.preview.href)} aria-label={`${s.title} ${image.label} 대화형 차트 열기`}><img src={url(image.src)} alt={`${s.title}, VO와 TQQQ의 ${image.label} 자산 성장 비교`} width="2880" height="1440" loading="lazy" decoding="async"/></a></section>)}</div>}<figcaption><span>{s.preview.comparison_note}</span><a href={url(s.preview.href)}>확대해서 보기 →</a></figcaption><div class="preview-period-links">{s.preview.periods.map((p:any)=><a href={url(s.preview.href+'#'+p.file.split('/').at(-1).replace('.json',''))}>{p.label} 크게 보기 →</a>)}</div></figure></>}
      {s.preview_unavailable&&<p class="caption">{s.preview_unavailable}</p>}
      <div class="method-detail-body">
        <div class="method-rule"><h3>어떻게 움직이나</h3><p>{s.mechanics}</p><p class="method-cadence">{s.cadence}</p></div>
        <div class="method-judgment"><h3>{featured?'기본 방법으로 남긴 이유':'검토 결과'}</h3><p>{s.decision}</p><h3>함께 볼 한계</h3><p>{s.limitation}</p></div>
      </div>
      <RuleExample id={s.id}/><div class="method-actions"><a href={url(href)}>{s.action_label||'규칙·성과·선택 근거 보기 →'}</a><a href={resultLink(s)}>{s.status==='실행 실패'?'실패 기록':'수치 원본'}</a>{s.status!=='실행 실패'&&<a href={compareLink(s)}>같은 조건으로 방법 비교 →</a>}</div>
    </div>
  </details>
</article>
