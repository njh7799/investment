---
import {url} from '../lib/content';
const {study,model,title='연도별 수익률과 MDD',sectionId='yearly'}=Astro.props;
---
<section id={sectionId} class="paper yearly-performance" data-yearly={url(study.yearly)} data-yearly-model={model}>
  <div class="panel-head">
    <div><h2>{title}</h2><p>한 해의 결과와 그해 감수한 최대 낙폭을 함께 봅니다.</p></div>
    <a class="download-chart" href={url(study.yearly)} download>계산 결과 JSON ↓</a>
  </div>
  <div class="yearly-controls" hidden>
    <label hidden={Boolean(model)}>방법 <select class="yearly-model" aria-label="연도별 성과 방법"></select></label>
  </div>
  <p class="yearly-note caption"></p>
  <div class="yearly-bars" role="img" aria-label="연도별 수익률과 최대 낙폭 막대그래프"></div>
  <button type="button" class="yearly-range-toggle" aria-expanded="false">전체 보기 <span aria-hidden="true">↓</span></button>
  <p class="yearly-empty empty" hidden></p>
</section>
<script>import '../lib/yearly';</script>
