---
import Layout from '../../layouts/Layout.astro';
import AddonControl from '../../components/AddonControl.astro';
import CurrentVoSnapshot from '../../components/CurrentVoSnapshot.astro';
import DetailContext from '../../components/DetailContext.astro';
import IxicAddonBacktest from '../../components/IxicAddonBacktest.astro';
import LatestBacktest from '../../components/LatestBacktest.astro';
import MethodConditions from '../../components/MethodConditions.astro';
import MethodMetrics from '../../components/MethodMetrics.astro';
import PeriodChart from '../../components/PeriodChart.astro';
import ProfileView from '../../components/ProfileView.astro';
import RuleExample from '../../components/RuleExample.astro';
import StrategyProfileResults from '../../components/StrategyProfileResults.astro';
import StressDots from '../../components/StressDots.astro';
import YearlyPerformance from '../../components/YearlyPerformance.astro';
import {data,url,document,markdown} from '../../lib/content';
import {methodInfo,resultLink} from '../../lib/methods';
import {strategyProfileConfig} from '../../lib/strategy-profile-config';

interface Props { strategy:any }

export function getStaticPaths(){
  return data.methods.map((strategy:any)=>({params:{id:strategy.id},props:{strategy}}));
}

const {strategy:s}=Astro.props;
const source=`docs/strategies/${s.id}/README.md`;
const doc=document(source);
const studies=(s.studies||[]).map((id:string)=>data.studies.find((study:any)=>study.id===id)).filter(Boolean);
const performanceStudy=data.studies.find((study:any)=>study.id===s.batch);
const info=methodInfo(s);
const profile=strategyProfileConfig(s.id);
const isVO=profile?.kind==='vo';
const isIXIC=profile?.kind==='ixic';
const addonDocs=(profile?.addons||[])
  .map((addon:any)=>({...addon,document:document(addon.source)}))
  .filter((addon:any)=>addon.document);

const rows=s.result_rows||[];
const hasResult=Boolean(s.metrics&&s.model);
const periodOrder:Record<string,number>={'recent-10y':0,'prior-10y':1,'early-10y':2};
const previewPeriods=s.preview
  ?[...s.preview.periods].sort((a:any,b:any)=>(periodOrder[a.id]??99)-(periodOrder[b.id]??99))
  :[];
---
<Layout title={s.title} section="strategies" detail>
  {profile&&<AddonControl strategyId={profile.strategy} title={profile.controlTitle} addons={profile.addons}/>}
  <DetailContext title={s.title}/>

  <div class="page-heading">
    <div class="report-meta">
      <span class="status-pill">역할 · {info.role}</span>
      <span class="status-pill">검증 · {info.status}</span>
      {profile&&<span class="status-pill addon-on-badge">{profile.badge}</span>}
      <span>{s.category}</span>
    </div>
    <h1>{s.title}</h1>
    <p>{profile?.pageSummary||s.summary}</p>
  </div>

  <nav class="report-sections" aria-label="방법 목차">
    <a href="#rules">작동 규칙</a>
    <a href="#performance">성과와 차트</a>
    <a href="#yearly">연도별 수익률</a>
    <a href="#stress">하락 스트레스</a>
    <a href="#evidence">선택 근거·관련 분석</a>
    {addonDocs.length>0&&<a href="#strategy-addons">Addon</a>}
  </nav>

  <section id="rules" class="method-rules paper">
    <h2>작동 규칙</h2>
    <p>{s.mechanics}</p>
    {profile&&profile.rules.map((rule:any)=><ProfileView strategy={profile.strategy} profile={rule.id} initialProfile={profile.initialProfile}>
      <div class:list={['active-addon-rule',{'is-core':rule.core}]}>
        <strong>{rule.title}</strong>
        <p>{rule.description}</p>
      </div>
    </ProfileView>)}
    <p class="method-cadence">{s.cadence}</p>
    {isVO&&<CurrentVoSnapshot/>}
    <RuleExample id={s.id}/>
    {doc?<details class="full-rules">
      <summary>전체 규칙과 실행 조건 읽기</summary>
      <div class="prose" set:html={markdown(doc.body.replace(/^# .*\n/,''),source)}/>
      <a href={url('downloads/'+source)} download>원본 규칙 내려받기 ↓</a>
    </details>:<p class="caption">세부 신호·체결 조건과 구현 근거는 <a href={url(`research/${s.batch}/#source-report`)}>연결된 분석 원문 →</a>에서 확인할 수 있습니다.</p>}
  </section>

  <p class="note">검증 범위: 과거 데이터 백테스트입니다. {isVO?'30일 기본값은 과거 데이터를 보고 선정했으며 미래 성과의 독립 검증을 마친 것은 아닙니다.':s.limitation}</p>

  <section id="performance" class="section-block">
    <h2>성과와 차트</h2>
    {profile?<StrategyProfileResults
      strategy={profile.strategy}
      initialProfile={profile.initialProfile}
      marketDate={profile.marketDate}
      heading={profile.heading}
      profiles={profile.profiles}
      yearlyStudy={profile.yearlyStudy}
      stressProfiles={profile.stressProfiles}
      downloads={profile.downloads}
      historicalLabel={profile.historicalLabel}
      method={s}
    />:hasResult?<div class="paper historical-spec">
      <h3>연구 당시 결과</h3>
      <MethodConditions method={s} showRecent/>
      <MethodMetrics metrics={s.metrics} recent={s.recent_metrics}/>
      <div class="downloads">
        {s.metric_source&&<a href={url('downloads/'+s.metric_source)} download>성과 원본 CSV ↓</a>}
        <a href={url(`research/${s.batch}/#results`)}>다른 평가 기간과 전체 결과</a>
        <a href={resultLink(s)}>이 수치와 같은 모델·기간 보기 →</a>
      </div>
    </div>:<div class="paper historical-spec">
      <h3>{s.is_family?'설정별 결과':'성과 미생성'}</h3>
      <p>{s.is_family?`${rows.length}개 설정을 하나의 대표 성과로 합치지 않았습니다. 설정별 수치는 연결된 분석 기록에서 비교할 수 있습니다.`:'사전등록한 실행 조건을 통과하지 못해 성과·연도별 값·하락 분포를 생성하지 않았습니다.'}</p>
      <div class="downloads"><a href={url(`research/${s.batch}/${s.status==='실행 실패'?'#failure':'#results'}`)}>분석 기록에서 확인 →</a></div>
    </div>}

    {!profile&&(hasResult&&performanceStudy
      ?<YearlyPerformance study={performanceStudy} model={s.model}/>
      :<section id="yearly" class="paper yearly-performance">
        <h2>연도별 수익률과 MDD</h2>
        <p class="empty">{s.is_family?'여러 설정을 하나의 연도별 값으로 합치지 않습니다. 연결된 분석 기록에서 설정을 선택해 확인하세요.':'저장된 일별 자산 곡선이 없어 계산할 수 없습니다.'}</p>
      </section>)}

    {!profile&&(s.stress
      ?<StressDots stress={s.stress}/>
      :<section id="stress" class="paper stress-section">
        <h2>하락 스트레스 분포</h2>
        <p class="empty">{s.is_family?'여러 설정을 하나의 하락 분포로 합치지 않습니다. 연결된 분석 기록에서 설정별 결과를 확인하세요.':'검증 가능한 단일 자산 곡선이 없어 계산하지 않았습니다.'}</p>
      </section>)}

    {isVO?<LatestBacktest/>:isIXIC?<IxicAddonBacktest/>:previewPeriods.length>0?<>
      <h3>기간별 자산 변화</h3>
      <p>최신 구간부터 표시하며, 각 구간은 같은 초기자산으로 다시 시작합니다.</p>
      <div class="split-chart-grid">
        {previewPeriods.map((period:any,index:number)=><PeriodChart file={period.file} title={`${period.label} · 자산 변화`} defaultOpen={index===0}/>)}
      </div>
      <p class="caption">연구 당시 저장된 코드·데이터로 복원한 곡선입니다. <a href={url(`research/${s.batch}/#downloads`)}>입력 데이터 해시·복원 정보 →</a></p>
    </>:<div class="paper">
      <h3>성과 차트</h3>
      <p class="empty">대표 설정을 임의로 고르지 않아 이 방법군의 단일 차트를 표시하지 않습니다.</p>
    </div>}
  </section>

  <section id="evidence" class="section-block">
    <h2>선택 근거와 관련 분석</h2>
    <div class="summary-grid">
      <div class="paper"><h3>판단 · {info.verdict}</h3><p>{s.decision}</p></div>
      <div class="paper"><h3>한계와 해석</h3><p>{s.limitation}</p></div>
    </div>
    <div class="evidence-list">
      {studies.map((study:any)=><article>
        <div><a href={url(`research/${study.id}/`)}>{study.title} →</a><span class="status-pill">{study.status}</span></div>
        <p>{study.finding}</p>
        {s.id==='ixic-three-percent-rule'&&study.id==='batch-11'&&<p class="caption">판본 비교 참고: 이 페이지의 10구간 규칙 성과는 단일 자산 타이밍 연구이며, Jordan 공개 규칙 연구와는 다른 판본입니다.</p>}
      </article>)}
    </div>
  </section>

  {addonDocs.length>0&&<section id="strategy-addons" class="section-block paper addon-details">
    <h2>Addon</h2>
    <p>현재 이 전략에서 선택할 수 있는 addon만 표시합니다. 모두 기본적으로 접혀 있으며 열어서 정확한 규칙을 확인할 수 있습니다.</p>
    {addonDocs.map((addon:any)=><details id={`addon-${addon.anchor}`}>
      <summary><span>{addon.label}</span><small>상세 규칙 보기</small></summary>
      <div class="prose" set:html={markdown(addon.document.body.replace(/^# .*\n/,''),addon.source)}/>
    </details>)}
  </section>}

  <div class="method-bottom-nav">
    <a href={url('strategies/')}>← 투자 방법</a>
    <a href={url('research/')}>전체 분석 기록 →</a>
  </div>
</Layout>
