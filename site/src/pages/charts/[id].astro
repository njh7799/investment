---
import Layout from '../../layouts/Layout.astro';
import DetailContext from '../../components/DetailContext.astro';
import PeriodChart from '../../components/PeriodChart.astro';
import {data,url} from '../../lib/content';
interface Props { method:any }
export function getStaticPaths(){return data.methods.filter((m:any)=>m.preview).map((m:any)=>({params:{id:m.id},props:{method:m}}))}
const {method:s}=Astro.props;
const source=`strategies/${s.id}/`;
const periodOrder:Record<string,number>={'recent-10y':0,'prior-10y':1,'early-10y':2};
const periods=[...s.preview.periods].sort((a:any,b:any)=>(periodOrder[a.id]??99)-(periodOrder[b.id]??99));
---
<Layout title={`${s.title} · 차트`} section="strategies" detail>
  <DetailContext title="성과 차트" ancestors={[{title:s.title,path:source}]} kind="차트 상세"/>
  <div class="page-heading"><h1>{s.title} · 성과 차트</h1><p>{s.preview.caption}. 카드 이미지와 같은 기간·시계열입니다.</p></div>
  <p class="note">{s.preview.comparison_note} 각 차트의 수익률·낙폭은 표시된 평가 구간만으로 계산합니다.</p>
  <div class="split-chart-grid">{periods.map((period:any,index:number)=><PeriodChart file={period.file} title={`${period.label} · 자산 성장과 낙폭`} defaultOpen={index===0}/>)}</div>
  <div class="downloads">{s.preview.images.map((image:any)=><a href={url(image.src)} download>{image.label} PNG ↓</a>)}<a href={url(source)}>방법의 규칙과 독립 평가 →</a></div>
  <details class="provenance"><summary>계산·복원 근거</summary><p>과거 연구는 당시 코드와 입력 해시를 복원하고 저장된 기간별 성과에 대조했습니다. TQQQ도 각 방법과 같은 실제 종료일·비용 조건으로 계산했습니다.</p><pre>{JSON.stringify(s.preview.provenance,null,2)}</pre></details>
</Layout>
