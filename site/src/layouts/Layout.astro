---
import {data,url} from '../lib/content';
import {methodHref} from '../lib/methods';
import NavIcon from '../components/NavIcon.astro';
import '../styles.css';
import '../design-system.css';
const {title,section='home',detail=false,wide=false,description='투자 방법별 백테스트 결과, 규칙, 한계와 해석을 모아 둔 분석 기록.'}=Astro.props;
const pathname=Astro.url.pathname.replace(/^\/investment\/?/,'').replace(/\/$/,'');
const strategiesOpen=section==='strategies';
const researchOpen=section==='research'||section==='audits';
const strategyItems=data.methods;
const activeMethod=pathname.startsWith('strategies/')?pathname.split('/')[1]:null;
---
<!doctype html>
<html lang="ko">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#7c3aed"/><link rel="icon" href={url('favicon.svg')}/><title>{title} · 투자 분석 기록</title></head>
<body data-section={section}>
  <a class="skip" href="#main">본문으로 이동</a>
  <header class="mobile-header">
    <button class="icon-button sidebar-trigger" type="button" aria-controls="site-sidebar" aria-expanded="false" aria-label="탐색 메뉴 열기"><span></span><span></span><span></span></button>
    <a class="mobile-brand" href={url()}><i>IR</i><span>투자 분석 기록</span></a>
    <a class="icon-button github-button" href="https://github.com/njh7799/investment" aria-label="GitHub 저장소"><NavIcon name="github"/></a>
  </header>
  <div class="app-shell">
    <aside id="site-sidebar" class="site-sidebar" aria-label="사이트 탐색">
      <a class="sidebar-brand" href={url()}><i>IR</i><span><strong>투자 분석 기록</strong><small>Investment Research</small></span></a>
      <nav class="sidebar-nav" aria-label="주요 메뉴">
        <p>둘러보기</p>
        <a class="sidebar-primary" href={url()} aria-current={section==='home'?'page':undefined}><NavIcon name="home"/><span>홈</span></a>
        <div class="sidebar-group">
          <a class:list={["sidebar-primary sidebar-parent",{active:strategiesOpen}]} data-sidebar-parent="strategies" href={url('strategies/')} aria-current={pathname==='strategies'?'page':undefined} aria-expanded={strategiesOpen} aria-controls="strategy-subnav"><NavIcon name="methods"/><span>투자 방법</span><i aria-hidden="true">›</i></a>
          <div id="strategy-subnav" class="sidebar-subnav" data-sidebar-subnav="strategies" data-open={String(strategiesOpen)} aria-hidden={!strategiesOpen} aria-label="투자 방법 목록" inert={!strategiesOpen}>
            <div class="sidebar-subnav-inner">
              {strategyItems.map((item:any)=><a href={url(methodHref(item))} data-method-id={item.id} aria-current={activeMethod===item.id?'page':undefined}>{item.title}</a>)}
            </div>
          </div>
        </div>
        <div class="sidebar-group">
          <a class:list={["sidebar-primary sidebar-parent",{active:researchOpen}]} data-sidebar-parent="research" href={url('research/')} aria-current={pathname==='research'?'page':undefined} aria-expanded={researchOpen} aria-controls="research-subnav"><NavIcon name="research"/><span>분석 기록</span><i aria-hidden="true">›</i></a>
          <div id="research-subnav" class="sidebar-subnav" data-sidebar-subnav="research" data-open={String(researchOpen)} aria-hidden={!researchOpen} aria-label="분석 기록 목록" inert={!researchOpen}>
            <div class="sidebar-subnav-inner">
              {data.studies.map((item:any)=><a href={url(`research/${item.id}/`)} aria-current={pathname===`research/${item.id}`?'page':undefined}>{item.title}</a>)}
              <a href={url('research/audits/')} aria-current={pathname==='research/audits'?'page':undefined}>조사 · 보류</a>
            </div>
          </div>
        </div>
      </nav>
      <div class="sidebar-meta">
        <span>시장 데이터</span><strong>{data.comparison.market_date}</strong>
        <a href="https://github.com/njh7799/investment"><NavIcon name="github"/>GitHub 저장소</a>
      </div>
    </aside>
    <button class="sidebar-overlay" type="button" aria-label="탐색 메뉴 닫기"></button>
    <div class="content-column">
      <main id="main" class:list={{"detail-page":detail,"wide-page":wide}}><slot/></main>
      <footer><div><strong>투자 분석 기록</strong><p>과거 데이터 기반 백테스트이며 실제 계좌 수익률이나 미래 성과를 뜻하지 않습니다.</p></div><div class="foot-meta">시장 데이터 {data.comparison.market_date}<br/>생성 {data.generated_at.slice(0,16).replace('T',' ')} UTC</div></footer>
    </div>
    <aside class="page-index" data-page-index hidden aria-label="현재 페이지 목차"><p>이 페이지</p><nav data-page-index-links></nav></aside>
  </div>
  <script is:inline define:vars={{due:data.comparison.next_expected_after,expected:data.comparison.next_expected_date}}>
    document.querySelectorAll('[data-freshness]').forEach(el=>{const late=Date.now()>Date.parse(due);el.textContent=`다음 기대 거래일: ${expected} · 확인 시각 기준: ${late?'예정 갱신 시각 경과':'다음 갱신 대기'}. 갱신 예정: ${new Date(due).toLocaleString('ko-KR',{timeZone:'Asia/Seoul'})} KST.`;if(late){el.classList.add('delayed');el.textContent+=' 최신 VO 비교에 이후 거래일이 아직 반영되지 않았습니다. 지연 원인은 이 화면에서 확인되지 않으며 연구 당시 결과에는 영향이 없습니다.'}});
  </script>
  <script>
    const sidebar=document.querySelector('#site-sidebar');
    const trigger=document.querySelector<HTMLButtonElement>('.sidebar-trigger');
    const overlay=document.querySelector<HTMLButtonElement>('.sidebar-overlay');
    const closeSidebar=()=>{document.body.classList.remove('sidebar-open');trigger?.setAttribute('aria-expanded','false')};
    trigger?.addEventListener('click',()=>{const open=document.body.classList.toggle('sidebar-open');trigger.setAttribute('aria-expanded',String(open))});
    overlay?.addEventListener('click',closeSidebar);
    sidebar?.querySelectorAll('a:not([data-sidebar-parent])').forEach(link=>link.addEventListener('click',closeSidebar));
    sidebar?.querySelectorAll<HTMLAnchorElement>('[data-sidebar-parent]').forEach(parent=>{
      const name=parent.dataset.sidebarParent!;
      const subnav=sidebar.querySelector<HTMLElement>(`[data-sidebar-subnav="${name}"]`)!;
      parent.addEventListener('click',event=>{
        const open=subnav.dataset.open==='true';
        const currentParent=parent.getAttribute('aria-current')==='page';
        if(!currentParent){closeSidebar();return}
        event.preventDefault();
        const next=!open;
        subnav.dataset.open=String(next);
        subnav.setAttribute('aria-hidden',String(!next));
        subnav.toggleAttribute('inert',!next);
        parent.setAttribute('aria-expanded',String(next));
      });
    });
    const index=document.querySelector<HTMLElement>('[data-page-index]');
    const indexLinks=document.querySelector<HTMLElement>('[data-page-index-links]');
    const headings=[...document.querySelectorAll<HTMLElement>('#main h2')].filter(heading=>!heading.closest('[data-no-toc]'));
    const slug=(value:string)=>value.trim().toLowerCase().replace(/[^\p{L}\p{N}\s-]/gu,'').replace(/\s+/g,'-');
    headings.forEach((heading,i)=>{if(!heading.id)heading.id=slug(heading.textContent||'')||`section-${i+1}`});
    if(index&&indexLinks&&headings.length){
      document.body.classList.add('has-page-index');
      index.hidden=false;
      indexLinks.innerHTML=headings.map(heading=>`<a class="toc-${heading.tagName.toLowerCase()}" href="#${encodeURIComponent(heading.id)}">${heading.textContent}</a>`).join('');
      const links=[...indexLinks.querySelectorAll<HTMLAnchorElement>('a')];
      const activate=(id:string)=>links.forEach(link=>link.setAttribute('aria-current',link.hash===`#${encodeURIComponent(id)}`?'location':'false'));
      const observer=new IntersectionObserver(entries=>{const visible=entries.filter(entry=>entry.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top);if(visible[0])activate((visible[0].target as HTMLElement).id)},{rootMargin:'-12% 0px -75% 0px'});
      headings.forEach(heading=>observer.observe(heading));activate(headings[0].id);
    }
    function revealLinkedRule(){
      let id;try{id=decodeURIComponent(location.hash.slice(1))}catch{return}
      const target=document.getElementById(id);if(!target)return;
      let parent:HTMLElement|null=target,opened=false;
      while(parent){if(parent instanceof HTMLDetailsElement&&!parent.open){parent.open=true;opened=true}parent=parent.parentElement}
      if(opened)requestAnimationFrame(()=>target.scrollIntoView());
    }
    window.addEventListener('hashchange',revealLinkedRule);revealLinkedRule();
  </script>
</body>
</html>
